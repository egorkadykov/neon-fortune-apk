<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Приложение на весь экран: без статус-бара, панели навигации и ActionBar. -->
    <style name="AppTheme" parent="@android:style/Theme.Material.Light.NoActionBar.Fullscreen">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowBackground">#050812</item>
        <!-- Не рисуем фон системных панелей: иначе некоторые прошивки оставляют верхний отступ. -->
        <item name="android:windowDrawsSystemBarBackgrounds">false</item>
    </style>
</resources>
